# Kommo: use o subdomínio sem https:// e sem .kommo.com
KOMMO_SUBDOMAIN=

# Token de longa duração ou access token. Configure somente no servidor/Vercel.
KOMMO_ACCESS_TOKEN=

# Opcionais: direcionam o lead para um funil e etapa específicos.
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=

# Compatibilidade opcional com um endpoint intermediário já existente.
KOMMO_WEBHOOK_URL=
